# Backend
# SQLAlchemy database URL
DATABASE_URL=sqlite:///./backend/data/app.db

# PostgreSQL deployment (supply credentials through the host's secret store):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full
# PostgreSQL pool limits per worker; ignored for SQLite
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Use false in production; run one approved migration job before starting workers
RUN_MIGRATIONS_ON_STARTUP=true

# Comma-separated allowed origins for FastAPI CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Mobile (Expo)
# Base URL used by mobile app API client
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Production API (Fly.io)
# EXPO_PUBLIC_API_BASE_URL=https://english-rhythm-coach-api.fly.dev
